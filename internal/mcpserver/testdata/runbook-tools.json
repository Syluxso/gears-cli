    "runbook_abilities": {"required": [], "args": []},
    "runbook_adopt": {"required": ["ref"], "args": ["as", "ref"]},
    "runbook_edit": {"required": ["runbook"], "args": ["description", "runbook", "steps", "title"]},
    "runbook_list": {"required": [], "args": []},
    "runbook_runs": {"required": [], "args": ["by", "card", "cursor", "limit", "mine", "runbook", "status"]},
    "runbook_show": {"required": ["runbook"], "args": ["runbook"]},
    "runbook_start": {"required": ["runbook"], "args": ["cardKey", "idempotencyKey", "runbook", "steps"]},
    "runbook_status": {"required": [], "args": ["card", "refresh", "run", "status"]},
    "runbook_step_complete": {"required": [], "args": ["evidence", "note", "run", "step"]},
    "runbook_step_skip": {"required": ["reason"], "args": ["note", "reason", "run", "step"]},
    "runbook_unadopt": {"required": ["runbook"], "args": ["runbook"]}
  },
  "localOnly": [
    "runbook_copy",
